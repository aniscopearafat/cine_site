Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^(?:app|tests|\.git)(?:/|$) - [F,L,NC]
RewriteRule ^(?:config(?:\.example)?\.php|composer\.(?:json|lock)|.*\.(?:sql|log|zip|bak))$ - [F,L,NC]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]
